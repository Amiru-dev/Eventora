# Eventora Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit the real .env file to version control

# === Database Configuration ===
DB_HOST=localhost
DB_NAME=eventora
DB_USER=root
DB_PASS=YOUR_MYSQL_PASSWORD_HERE
DB_CHARSET=utf8mb4

# === Application Configuration ===
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Colombo
APP_CURRENCY=LKR

# === Mail Configuration (PHPMailer + Gmail SMTP) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD_HERE
MAIL_SIMULATE=true

# === PayHere Payment Gateway ===
PAYHERE_MERCHANT_ID=YOUR_PAYHERE_SANDBOX_MERCHANT_ID
PAYHERE_SECRET=YOUR_PAYHERE_SANDBOX_SECRET
