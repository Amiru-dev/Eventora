<?php
/**
 * Database Configuration
 *
 * PDO connection to the shared MySQL database.
 * All Eventora tables reside in this single database.
 *
 * INSTRUCTIONS:
 * 1. Copy this file to database.php
 * 2. Replace the placeholder values with your actual database credentials
 * 3. DO NOT commit the real database.php file to version control
 */

define('DB_HOST', 'localhost');
define('DB_NAME', 'eventora');
define('DB_USER', 'root');
define('DB_PASS', 'YOUR_MYSQL_PASSWORD_HERE');
define('DB_CHARSET', 'utf8mb4');

/**
 * Get PDO database connection (singleton pattern)
 *
 * @return PDO
 */
function getDBConnection(): PDO
{
    static $pdo = null;

    if ($pdo === null) {
        $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=" . DB_CHARSET;
        $options = [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES   => false,
        ];

        try {
            $pdo = new PDO($dsn, DB_USER, DB_PASS, $options);
        } catch (PDOException $e) {
            error_log("Database connection error: " . $e->getMessage());
            throw $e;
        }
    }

    return $pdo;
}

/**
 * Safe helper to get PDO connection or null if database is unreachable.
 *
 * @return PDO|null
 */
function get_db_connection(): ?PDO
{
    try {
        return getDBConnection();
    } catch (\Throwable $e) {
        return null;
    }
}
